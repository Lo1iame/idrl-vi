font.family: sans-serif
font.sans-serif: Inter, Noto Sans CJK SC, DejaVu Sans
font.size: 10
text.color: 182a43
axes.labelcolor: 182a43
axes.edgecolor: 52637a
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: dce4ef
grid.linewidth: 0.6
xtick.color: 52637a
ytick.color: 52637a
lines.linewidth: 1.6
lines.markersize: 5
legend.frameon: False
figure.facecolor: ffffff
axes.facecolor: ffffff
savefig.facecolor: ffffff
savefig.dpi: 300
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
