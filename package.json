{
  "name": "idrl-design-system",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "vi:check": "node scripts/vi-kit.mjs check",
    "vi:export": "node scripts/vi-kit.mjs export",
    "vi:example": "vite --host 127.0.0.1",
    "vi:example:build": "tsc --noEmit -p examples/adoption/tsconfig.json && vite build --config examples/adoption/vite.config.ts",
    "test:vi": "node --test tests/vi-kit.test.mjs",
    "test": "playwright test",
    "brand:check": "node scripts/asset-runtime.cjs brand",
    "brand:build": "node scripts/build-brand.cjs",
    "deck:check": "node scripts/asset-runtime.cjs deck",
    "deck:build": "node scripts/build-deck.cjs",
    "test:assets": "node --test tests/asset-runtime.test.cjs tests/presentation-palette.test.mjs",
    "vi:check:ui": "node scripts/vi-kit.mjs check-ui",
    "vi:verify": "node scripts/vi-kit.mjs verify"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
